# ─────────────────────────────────────────────────────────────────────────────
# Medical365 HMS — Client Environment Variables (.env.example)
# Copy this file to .env or .env.local for local frontend development.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API Base URL
# For local development with backend running on port 3000:
VITE_API_URL=http://localhost:3000

# Domain Configuration (for multi-tenant subdomain resolution)
# For local dev using subdomains (e.g., clinic.localhost:5173, admin.localhost:5173):
VITE_BASE_DOMAIN=localhost
VITE_ADMIN_HOST=admin.localhost

# Optional: Dedicated Tenant ID (for single-tenant / white-label builds)
# VITE_APP_TENANT_ID=

# Optional: App Display Name
# VITE_APP_NAME=Medical365 HMS
